<%- include('partials/header') %>

<section class="form-page">
  <h1>Two-Factor Authentication</h1>
  <p>Enter the 6-digit code from your authenticator app to complete login.</p>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <ul>
        <% errors.forEach(err => { %>
          <li><%= err %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/auth/verify-mfa" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label for="token">6-Digit Code</label>
      <input type="text" id="token" name="token" required maxlength="6" pattern="[0-9]{6}"
             placeholder="000000" autocomplete="off">
    </div>

    <button type="submit" class="btn">Verify</button>
  </form>
</section>

<%- include('partials/footer') %>
