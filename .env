# ==========================================
# MFA / TOTP
# ==========================================

# Name shown in the authenticator app (e.g. Google Authenticator)
# This is what users will see next to the 6-digit code
TOTP_APP_NAME=Animal Charity Blog

# ==========================================
# ADMIN SEED ACCOUNT
# ==========================================

# Credentials for the first admin account created when seeding the DB
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@charityblog.dev
ADMIN_PASSWORD=Chicken123

# ==========================================
# RATE LIMITING
# ==========================================

# Max login attempts before rate limiter blocks the IP
RATE_LIMIT_MAX_ATTEMPTS=5

# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max failed attempts before account is locked
ACCOUNT_LOCKOUT_THRESHOLD=10

# ==========================================
# FILE UPLOADS
# ==========================================

# Max file size in bytes (5242880 = 5MB)
MAX_FILE_SIZE=5242880

# Folder where uploaded pet images are stored
UPLOAD_DIR=uploads