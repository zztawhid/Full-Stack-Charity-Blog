# ==========================================
# SERVER
# ==========================================

PORT=3000
NODE_ENV=development

# ==========================================
# DATABASE
# ==========================================

# Your PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DB_HOST=localhost
DB_PORT=5432
DB_NAME=charity_blog
DB_USER=postgres
DB_PASSWORD=Chicken123

# ==========================================
# SESSION
# ==========================================

# Long random string — used to sign session cookies
# Generate one at: https://randomkeygen.com (use "Fort Knox Passwords")
SESSION_SECRET="E?bJMvY5jix)@S?oI10+nM^Bl1e4aN.+"

# Session duration in milliseconds
# 1800000 = 30 minutes
SESSION_DURATION=1800000

# ==========================================
# PASSWORD SECURITY
# ==========================================

# Server-side pepper appended to passwords before hashing
# Generate another long random string — different from SESSION_SECRET
# If this leaks, all passwords are compromised — keep it safe
PEPPER="4N_n&k2S=YB,Q3v8Sqc?gLf&H)!LnuPB"

# ==========================================
# DATABASE ENCRYPTION
# ==========================================

# Key used by pgcrypto to encrypt sensitive columns (email, TOTP secret etc.)
# Generate another strong random string
# If this leaks, all encrypted DB fields are compromised
DB_ENCRYPTION_KEY="YOvQl;h!{LUreWNGA^!c5+L@{tivIF!0"

# ==========================================
# STRIPE
# ==========================================

# From Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_51TJCzgEhfAH12SSdKcKOJK0la8TBdHbm7P8zegaZyF7c7KvhEkJRtl3RaD5r0feVmenCjRCbPRWYvzWbCUZGLdE600hhtnBFWy
STRIPE_PUBLISHABLE_KEY=pk_test_51TJCzgEhfAH12SSdgV3OnSlYO8Sc9EA1cF9ARRH9Uni16K4Hb2ZxaXaFsbdtPuwXILfOWptl50RZnpFLLIjIGOQR00RFaYUHgu

